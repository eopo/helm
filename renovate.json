{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Professional dependency and release version automation for Helm chart maintenance",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 5am every weekday"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": "helm",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "prCreation": "status-success",
  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "rangeStrategy": "bump",
  "labels": [
    "dependencies",
    "helm"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/charts\\/paperless-ngx\\/Chart\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts\\/paperless-ngx\\/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*paperless-ngx/paperless-ngx\\s*[\\r\\n]+\\s*tag:\\s*\\\"?(?<currentValue>[^\\\"\\s]+)\\\"?"
      ],
      "depNameTemplate": "ghcr.io/paperless-ngx/paperless-ngx",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts\\/paperless-ngx\\/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*\\\"?(?<currentValue>[0-9A-Za-z.+-]+)\\\"?"
      ],
      "depNameTemplate": "ghcr.io/paperless-ngx/paperless-ngx",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/charts\\/paperless-ngx\\/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*ghcr\\.io/paperless-ngx/paperless-ngx:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/paperless-ngx/paperless-ngx",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge non-breaking updates after CI succeeds",
      "matchManagers": [
        "helmv3",
        "custom.regex",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "assignAutomerge": true,
      "labels": [
        "automerge",
        "non-breaking"
      ]
    },
    {
      "description": "Major updates require manual intervention in PR",
      "matchManagers": [
        "helmv3",
        "custom.regex",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "manual-intervention-required",
        "breaking-change-candidate"
      ]
    },
    {
      "description": "Bundle core stateful dependencies together",
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "postgresql",
        "redis"
      ],
      "groupName": "database-subcharts"
    },
    {
      "description": "Keep Paperless image related fields updated together",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/paperless-ngx/paperless-ngx"
      ],
      "groupName": "paperless-upstream-image",
      "groupSlug": "paperless-upstream-image",
      "matchManagers": [
        "custom.regex"
      ]
    }
  ],
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}

